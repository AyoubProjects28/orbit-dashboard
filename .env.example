# Copier sur web-test01 vers /opt/orbit/.env, en mode 600, propriétaire root.
# NE JAMAIS committer le .env rempli — ce fichier-ci ne contient que des exemples.
#
#   sudo install -m 600 -o root -g root .env.example /opt/orbit/.env && sudo vi /opt/orbit/.env

# Registry GitLab (fourni par la CI via $CI_REGISTRY_IMAGE ; à renseigner pour
# un déploiement manuel).
REGISTRY=registry.gitlab.example.com/cast.nasa/orbit
TAG=latest
MCP_TAG=latest

# Secrets — à RÉGÉNÉRER (les valeurs actuelles ont été exposées, cf. §0 de
# MIGRATION_docker_before_after.md).
ORBIT_MCP_TOKEN=
ANTHROPIC_API_KEY=

# LLM (llm-test01)
ORBIT_LLM_URL=http://172.18.53.7:11434
ORBIT_LLM_MODEL=qwen2.5:3b-instruct

# Agent de collecte JB sur llm-test01
AGENT_LLM_URL=http://172.18.53.7:9100/

# Agents psutil pour l'onglet Infra du dashboard (un par VM)
ORBIT_AGENT_LLM_URL=http://172.18.53.7:9100/metrics
ORBIT_AGENT_WEB_URL=http://172.18.53.11:9100/metrics

# Tarifs affichés par le dashboard
ANTHROPIC_PRICE_IN=0.000002
ANTHROPIC_PRICE_OUT=0.000010

WEB_PORT=80
